FITCHECK_ENV=production
FITCHECK_DATABASE_URL=postgresql+psycopg://fitcheck:URL_ENCODED_PASSWORD@postgres:5432/fitcheck
OPEN_AI_KEY=REPLACE_WITH_WORKER_PROVIDER_KEY
OPEN_AI_MODEL=gpt-6-luna
FITCHECK_WORKER_DRAIN_SECONDS=130
FITCHECK_GUEST_DEMO_LIMIT=1
FITCHECK_ACCOUNT_ANALYSIS_DAILY_LIMIT=0
FITCHECK_BUDGET_ACCOUNT_DAILY_USD=0
FITCHECK_BUDGET_DEPLOYMENT_DAILY_USD=0
FITCHECK_METRICS_ENABLED=true
FITCHECK_METRICS_ENVIRONMENT=production
FITCHECK_METRICS_DATABASE_ENVIRONMENT=production
# Optional OpenAI egress proxy. Squid uses HTTP even for HTTPS CONNECT tunnels.
# HTTPS_PROXY=http://proxy.example.com:3128
# HTTP_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1,::1,api,postgres
