FITCHECK_BACKEND_URL=http://api:8000
FITCHECK_WEBSITE_ORIGIN=https://fitcheck.dokploy.gcexp.ru
# Enable after verifying the ingress and API trust configuration in ops/RUNBOOK.md.
FITCHECK_TRUST_PROXY_HEADERS=false
ALLOWED_ORIGINS=https://fitcheck.dokploy.gcexp.ru
# Configure the API's HTTPS collector route before opening production traffic.
METRICS_BACKEND_URL=https://fitcheck-api.dokploy.gcexp.ru
METRICS_BRIDGE_KEY=REPLACE_WITH_METRICS_INGEST_KEY
METRICS_COOKIE_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_COOKIE_SECRET
METRICS_ENVIRONMENT=production
METRICS_ALLOW_LOCAL_HTTP=false
METRICS_CAMPAIGN_CODES=
# Provider keys and prompts do not belong in this container.
