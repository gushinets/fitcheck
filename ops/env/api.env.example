FITCHECK_ENV=production
FITCHECK_HOST=0.0.0.0
FITCHECK_PORT=8000
FITCHECK_DATABASE_URL=postgresql+psycopg://fitcheck:URL_ENCODED_PASSWORD@postgres:5432/fitcheck
FITCHECK_AUTH_ENABLED=true
FITCHECK_JOBS_ENABLED=true
FITCHECK_GUEST_ENABLED=true
FITCHECK_AUTH_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
FITCHECK_AUTH_WEB_BASE_URL=https://fitcheck.example.com
FITCHECK_ALLOWED_ORIGINS=["https://fitcheck.example.com"]
FITCHECK_OPS_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OPEN_AI_MODEL=gpt-6-luna
# Add all FITCHECK_SMTP_* values from backend/.env.example to enable email.
# No provider key belongs on this API container.
