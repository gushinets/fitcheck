FITCHECK_ENV=production
FITCHECK_HOST=0.0.0.0
FITCHECK_PORT=8000
FITCHECK_DATABASE_URL=postgresql+psycopg://fitcheck:URL_ENCODED_PASSWORD@postgres:5432/fitcheck
FITCHECK_AUTH_ENABLED=true
FITCHECK_JOBS_ENABLED=true
FITCHECK_GUEST_ENABLED=true
FITCHECK_AUTH_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
FITCHECK_AUTH_WEB_BASE_URL=https://fitcheck.dokploy.gcexp.ru
FITCHECK_ALLOWED_ORIGINS=["https://fitcheck.dokploy.gcexp.ru"]
# Set to the website relay's fixed IP or dedicated trusted subnet, never '*'.
# Required with website FITCHECK_TRUST_PROXY_HEADERS=true; see ops/RUNBOOK.md.
FITCHECK_TRUSTED_PROXY_IPS=[]
FITCHECK_OPS_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OPEN_AI_MODEL=gpt-6-luna
# Production policy: one guest analysis; no account analysis count or daily spend cap.
FITCHECK_GUEST_DEMO_LIMIT=1
FITCHECK_ACCOUNT_ANALYSIS_DAILY_LIMIT=0
FITCHECK_BUDGET_ACCOUNT_DAILY_USD=0
FITCHECK_BUDGET_DEPLOYMENT_DAILY_USD=0
# Replace this placeholder with the same secret as website METRICS_BRIDGE_KEY.
FITCHECK_METRICS_ENABLED=true
FITCHECK_METRICS_ENVIRONMENT=production
FITCHECK_METRICS_DATABASE_ENVIRONMENT=production
FITCHECK_METRICS_INGEST_KEY=REPLACE_WITH_METRICS_INGEST_KEY
FITCHECK_METRICS_CAMPAIGN_CODES=[]
# Add all FITCHECK_SMTP_* values from backend/.env.example to enable email.
# No provider key belongs on this API container.
