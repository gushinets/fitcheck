# Website's server-only connection to the separate FitCheck API.
# Copy to .env.local. No provider key is needed by the website.
FITCHECK_BACKEND_URL=http://127.0.0.1:8000
# Exact public website origin; must also be in backend FITCHECK_ALLOWED_ORIGINS.
FITCHECK_WEBSITE_ORIGIN=http://localhost:3000
# Used by the optional metrics bridge, independent of product API auth.
ALLOWED_ORIGINS=http://localhost:3000,https://dev-fitcheck.dokploy.gcexp.ru

# Optional server-only metrics bridge; disabled until all settings are supplied.
# Use a fixed HTTPS backend origin; bridge key matches backend ingestion key.
# Generate independent high-entropy bridge and cookie secrets, never provider keys.
# All METRICS_* keys are server-only; never use NEXT_PUBLIC_ for secrets.
METRICS_BACKEND_URL=
METRICS_BRIDGE_KEY=
METRICS_COOKIE_SECRET=
# Explicit telemetry partition, independent of NODE_ENV production builds.
METRICS_ENVIRONMENT=development
# Local development only: allows HTTP localhost/127.0.0.1/::1 (never production).
METRICS_ALLOW_LOCAL_HTTP=false
# HTTP admissions/minute per Next process (POST and DELETE share the budget).
# Defaults support 31 active visitors: 62 pulses + 62 page/action requests/minute.
# Backend defaults allow two Next processes at these limits; scale both sides together.
METRICS_RATE_LIMIT_PER_MINUTE=600
METRICS_VISITOR_RATE_LIMIT_PER_MINUTE=30
# Rebuild/redeploy after enabled-state or campaign changes: / is prerendered.
# Public allowlisted campaign codes (comma-separated); mirror backend
# FITCHECK_METRICS_CAMPAIGN_CODES JSON list. Unknown UTM values become other.
METRICS_CAMPAIGN_CODES=
