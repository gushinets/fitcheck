FITCHECK_ENV=dev
FITCHECK_HOST=127.0.0.1
FITCHECK_PORT=8000
FITCHECK_ALLOWED_ORIGINS=[]
FITCHECK_LOG_LEVEL=info
FITCHECK_API_BODY_MAX_BYTES=1048576
# Optional for foundation API; required for storage/migrations.
# FITCHECK_DATABASE_URL=postgresql+psycopg://fitcheck_test:fitcheck_test@127.0.0.1:55464/fitcheck_test
FITCHECK_POOL_SIZE=2
FITCHECK_MAX_OVERFLOW=3
FITCHECK_POOL_TIMEOUT_SECONDS=5
FITCHECK_STATEMENT_TIMEOUT_MS=15000
# Enable only after explicit migration upgrade/check; SMTP can remain unconfigured.
FITCHECK_AUTH_ENABLED=false
# Optional for API admission; required only in the LLM worker's server environment.
# OPEN_AI_KEY=<provider-key>
# Optional worker-only egress proxy; HTTPX honors HTTPS_PROXY/ALL_PROXY and NO_PROXY.
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1,::1,api,postgres
# Must match the worker and API admission registry.
OPEN_AI_MODEL=gpt-6-luna
# Generate a unique hex secret with at least 32 random bytes; never commit it.
# FITCHECK_AUTH_SECRET=<generated-secret>
# FITCHECK_AUTH_WEB_BASE_URL=https://dev-fitcheck.dokploy.gcexp.ru
# Explicit proxy addresses/CIDRs only; never trust '*'. Default ignores forwarded headers.
FITCHECK_TRUSTED_PROXY_IPS=[]
# Configure all SMTP values together; no console/fake production delivery.
# FITCHECK_SMTP_HOST=smtp.example.com
# FITCHECK_SMTP_PORT=465
# FITCHECK_SMTP_USERNAME=<sender-user>
# FITCHECK_SMTP_PASSWORD=<sender-password>
# FITCHECK_SMTP_FROM=sender@example.com
# FITCHECK_SMTP_SECURITY=smtps
# STARTTLS alternative: SMTP_SECURITY=starttls with the provider's TLS submission port.
# Separate worker: provider key belongs in worker environment.
FITCHECK_JOBS_ENABLED=false
FITCHECK_WORKER_POLL_INTERVAL=1
FITCHECK_WORKER_LEASE_SECONDS=150
FITCHECK_WORKER_HEARTBEAT_SECONDS=20
FITCHECK_WORKER_DRAIN_SECONDS=130

# Apply additive 0004_metrics + 0005_metrics_erasure before enabling API/worker.
# Internal website telemetry is disabled until all settings are configured.
FITCHECK_METRICS_ENABLED=false
# Explicit development, production or test; independent of build mode.
# FITCHECK_METRICS_ENVIRONMENT=development
# Independent physical database scope for legacy provider/domain reports and backfill.
# Do not change this when collecting synthetic events under the test environment.
# FITCHECK_METRICS_DATABASE_ENVIRONMENT=development
# Match website METRICS_BRIDGE_KEY; use a separate high-entropy non-provider secret.
# FITCHECK_METRICS_INGEST_KEY=server-only-bridge-secret
# Mirror website METRICS_CAMPAIGN_CODES comma-separated public codes here as JSON.
FITCHECK_METRICS_CAMPAIGN_CODES=[]
# Shared PostgreSQL admissions/minute/environment across all API and Next replicas.
# Covers two Next processes at 600 aggregate / 30 per visitor each.
FITCHECK_METRICS_RATE_LIMIT_PER_MINUTE=1200
FITCHECK_METRICS_VISITOR_RATE_LIMIT_PER_MINUTE=60

# ANY-651: guest admission stays disabled until matching API/worker rollout.
FITCHECK_GUEST_ENABLED=false
FITCHECK_GUEST_TTL_SECONDS=86400
FITCHECK_GUEST_DEMO_LIMIT=1
FITCHECK_GUEST_SUGGESTIONS_LIMIT=5
FITCHECK_GUEST_EXTRACTION_LIMIT=10
FITCHECK_ACCOUNT_ANALYSIS_DAILY_LIMIT=20
FITCHECK_ACCOUNT_SUGGESTIONS_DAILY_LIMIT=50
FITCHECK_ACCOUNT_EXTRACTION_DAILY_LIMIT=100
FITCHECK_BUDGET_ANALYSIS_USD=0.02
FITCHECK_BUDGET_SUGGESTIONS_USD=0.005
FITCHECK_BUDGET_GUEST_USD=0.05
FITCHECK_BUDGET_ACCOUNT_DAILY_USD=0.50
FITCHECK_BUDGET_DEPLOYMENT_DAILY_USD=10.00
FITCHECK_GUEST_MAX_ACTIVE_JOBS=1
FITCHECK_ACCOUNT_MAX_ACTIVE_JOBS=2
FITCHECK_GUEST_CREATE_HOURLY_LIMIT=3
FITCHECK_GUEST_CREATE_DAILY_LIMIT=10
FITCHECK_BUDGET_ANALYSIS_CALLS=8
FITCHECK_BUDGET_SUGGESTIONS_CALLS=4
FITCHECK_BUDGET_ANALYSIS_TOKENS=40000
FITCHECK_BUDGET_SUGGESTIONS_TOKENS=10000

# Private operational metrics; disabled without a separate bearer token.
# FITCHECK_OPS_TOKEN=<random-secret-at-least-32-characters>
# FITCHECK_OPS_STATE_DIR=/var/lib/fitcheck-ops
# Worker-only HTTP metrics; 0 disables the listener. Bind privately.
# FITCHECK_WORKER_METRICS_HOST=127.0.0.1
# FITCHECK_WORKER_METRICS_PORT=9109
