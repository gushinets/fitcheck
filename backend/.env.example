FITCHECK_ENV=dev
FITCHECK_HOST=127.0.0.1
FITCHECK_PORT=8000
FITCHECK_ALLOWED_ORIGINS=[]
FITCHECK_LOG_LEVEL=info
FITCHECK_API_BODY_MAX_BYTES=1048576
# Optional for foundation API; required for storage/migrations.
# FITCHECK_DATABASE_URL=postgresql+psycopg://fitcheck_test:fitcheck_test@127.0.0.1:55464/fitcheck_test
FITCHECK_POOL_SIZE=2
FITCHECK_MAX_OVERFLOW=3
FITCHECK_POOL_TIMEOUT_SECONDS=5
FITCHECK_STATEMENT_TIMEOUT_MS=15000
# Enable only after explicit migration upgrade/check; SMTP can remain unconfigured.
FITCHECK_AUTH_ENABLED=false
# Optional until the LLM worker is enabled; never put provider keys in website settings.
# FITCHECK_DEEPSEEK_API_KEY=<provider-key>
# Generate a unique hex secret with at least 32 random bytes; never commit it.
# FITCHECK_AUTH_SECRET=<generated-secret>
# FITCHECK_AUTH_WEB_BASE_URL=https://dev-fitcheck.dokploy.gcexp.ru
# Explicit proxy addresses/CIDRs only; never trust '*'. Default ignores forwarded headers.
FITCHECK_TRUSTED_PROXY_IPS=[]
# Configure all SMTP values together; no console/fake production delivery.
# FITCHECK_SMTP_HOST=smtp.example.com
# FITCHECK_SMTP_PORT=465
# FITCHECK_SMTP_USERNAME=<sender-user>
# FITCHECK_SMTP_PASSWORD=<sender-password>
# FITCHECK_SMTP_FROM=sender@example.com
# FITCHECK_SMTP_SECURITY=smtps
# STARTTLS alternative: SMTP_SECURITY=starttls with the provider's TLS submission port.
