FITCHECK_ENV=dev
FITCHECK_HOST=127.0.0.1
FITCHECK_PORT=8000
FITCHECK_ALLOWED_ORIGINS=[]
FITCHECK_LOG_LEVEL=info
FITCHECK_API_BODY_MAX_BYTES=1048576
# Optional for foundation API; required for storage/migrations.
# FITCHECK_DATABASE_URL=postgresql+psycopg://fitcheck_test:fitcheck_test@127.0.0.1:55464/fitcheck_test
FITCHECK_POOL_SIZE=2
FITCHECK_MAX_OVERFLOW=3
FITCHECK_POOL_TIMEOUT_SECONDS=5
FITCHECK_STATEMENT_TIMEOUT_MS=15000
