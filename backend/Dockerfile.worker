FROM ghcr.io/astral-sh/uv:0.12.7 AS uv
FROM python:3.15-slim
COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_NO_CACHE=1 FITCHECK_ENV=production
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini
RUN uv sync --locked --no-dev --no-editable \
    && groupadd --gid 10001 fitcheck \
    && useradd --uid 10001 --gid fitcheck --no-create-home fitcheck
USER fitcheck
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/app/.venv/bin/python", "-m", "fitcheck_backend.worker.health"]
CMD ["/app/.venv/bin/python", "-m", "fitcheck_backend.worker"]
